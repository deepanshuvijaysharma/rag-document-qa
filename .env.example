# ============================================================================
# RAG Document Q&A - Environment Variables Configuration Template
# ============================================================================

# Application Environment
APP_ENV=development
APP_NAME="RAG Document Q&A"
API_PREFIX="/api/v1"

# LLM Provider Selection (Options: openai, ollama, groq, anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API Keys (Never commit actual API keys to git repository!)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Local Development (If LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store & Embedding Settings
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Ingestion Threshold Boundaries
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=500
TOP_K=4
MAX_CONTEXT_CHUNKS=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# CORS Allowed Origins
FRONTEND_ORIGIN=http://localhost:5173
