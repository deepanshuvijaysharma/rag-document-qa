# ==========================================
# RAG Document Q&A Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="RAG Document Q&A"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Storage & Vector Database Paths
CHROMA_PERSIST_DIR="./data/chroma"
CHROMA_COLLECTION_NAME="rag_documents"

# Embedding Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM Provider Configuration
# Supported options: openai, ollama, groq, anthropic
LLM_PROVIDER="openai"
DEFAULT_MODEL_NAME="gpt-4o-mini"

# Provider API Keys (Fill in your respective API key)
OPENAI_API_KEY="your_openai_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Local Ollama Configuration (if using LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
